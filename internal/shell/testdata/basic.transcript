# basic.transcript — exercises every D-35 directive: comment, <<, @delay, >>
# '<<' = lines the mock emits onto the channel
# '>>' = stdin write the test EXPECTS the consumer to have made
# '@delay' = pacing for the next emit
<< %begin 1700000000 1 0
@delay 10ms
<< %end 1700000000 1 0
>> list-panes -a
