{
    "tagOwners": {
        "tag:laptop": [
            "owner@example.com"
        ],
        "tag:mobile": [
            "owner@example.com"
        ]
    },
    "grants": [
        {
            "src": [
                "tag:mobile"
            ],
            "dst": [
                "tag:laptop"
            ],
            "ip": [
                "tcp:22",
                "tcp:2586",
                "tcp:2587",
                "udp:60000-61000"
            ]
        }
    ],
    "ssh": [
        {
            "action": "accept",
            "src": [
                "tag:mobile"
            ],
            "dst": [
                "tag:laptop"
            ],
            "users": [
                "macuser",
                "autogroup:nonroot"
            ]
        }
    ]
}