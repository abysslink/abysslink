#
# AUD-08: blocks real secrets from entering testdata/fuzz/ corpus (and any
# other staged file) before the commit lands. The fuzz seed corpus is committed
# to git, so a gitleaks scan on staged content is the first line of defence
# against a credential slipping into a corpus file.
#
# Activate with: git config core.hooksPath .githooks
set -euo pipefail

if command -v gitleaks &>/dev/null; then
    # Scan ONLY the staged content that is about to be committed. --redact keeps
    # any matched secret out of the hook's own output; --exit-code 1 makes a
    # finding block the commit. The staged-scan CLI moved between gitleaks
    # versions: `gitleaks git --staged` (>= 8.19, repo path positional) vs the
    # older `gitleaks protect --staged --source <path>` (<= 8.18). `detect`
    # never had --staged. Dispatch on which subcommand the installed binary has.
    _repo_root="$(git rev-parse --show-toplevel)"
    if gitleaks git --help >/dev/null 2>&1; then
        gitleaks git --staged --redact --exit-code 1 \
            --log-level warn --no-banner "${_repo_root}"
    else
        gitleaks protect --staged --redact --exit-code 1 \
            --log-level warn --no-banner --source "${_repo_root}"
    fi
else
    # Graceful degradation (RESEARCH.md Pattern 7): gitleaks is optional on dev
    # machines. The CI gitleaks-action provides the hard gate, so a missing
    # local binary must WARN and exit 0 rather than block every commit.
    echo "WARNING: gitleaks not installed — skipping secret scan. Install: brew install gitleaks"
fi
